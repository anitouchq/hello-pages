{
  "name": "hello-pages-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate \"index.html\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:js": "eslint \"src/**/*.{js,jsx}\" \"vite.config.js\"",
    "ci": "npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "html-validate": "^8.24.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.67.5"
  }
}
